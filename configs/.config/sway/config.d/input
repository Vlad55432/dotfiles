# It's just a keyboard and mouse config, nothin else
#I want to get us hotkeys working in ua and ru language. In nano, you can't do ctrl+x y in ua,ru language
input type:keyboard {
    repeat_delay 300
    repeat_rate 30
    xkb_model "pc104"
    xkb_layout "us,ua,ru"
    xkb_options "grp:alt_shift_toggle"
    xkb_numlock enabled
}
input 1267:12652:ELAN0735:00_04F3:316C_Touchpad {
	dwtp enabled
	dwt enabled
	tap enabled
	middle_emulation enabled
}

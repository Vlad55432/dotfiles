#### This config includes style, like theme, walppaper and such things

# gtk theme, how tf I can apply qt theme from config??
set $gnome-schema org.gnome.desktop.interface

exec_always {
    gsettings set $gnome-schema gtk-theme 'gruvbox-dark-gtk'
    gsettings set $gnome-schema icon-theme 'Gruvbox-Plus-Dark'
    gsettings set $gnome-schema cursor-theme 'Gruvbox-Retro'
    gsettings set $gnome-schema font-name 'JetBrains Mono Nerd Font Medium 10'
}

# sway looks
client.focused #fbf1c7 #fbf1c7 #fbf1c7 #fbf1c7
client.unfocused #282828 #282828 #282828 #282828
default_border pixel 3
gaps inner 3
gaps outer 3

# Font
font pango:JetBrains Mono Nerd Font Medium 10

